# Optional LLM (OpenAI-compatible). Offline planner works without these.
FORMBANE_LLM_ENABLED=false
FORMBANE_LLM_BASE_URL=https://api.openai.com
FORMBANE_LLM_API_KEY=
FORMBANE_LLM_MODEL=gpt-4o-mini

# Aliases also accepted:
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Headless browser (CI)
# FORMBANE_HEADLESS=1

# Override data dir (default ~/.formbane)
# FORMBANE_HOME=
